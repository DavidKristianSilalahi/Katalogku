@page
@model CheckoutModel
@{ ViewData["Title"] = "Checkout"; }
<section class="page-heading"><a class="back-link" asp-page="/Cart">&larr; Kembali ke keranjang</a><p class="eyebrow">Langkah terakhir</p><h1>Checkout<br /><em>lebih tenang.</em></h1></section>
<div class="checkout-layout"><form method="post" class="checkout-form"><div asp-validation-summary="ModelOnly" class="validation"></div><p class="eyebrow">Data pengiriman</p><h2>Kirim ke mana?</h2><div class="field"><label asp-for="Name">Nama penerima</label><input asp-for="Name" placeholder="Nama lengkap" /></div><div class="field"><label asp-for="Address">Alamat lengkap</label><textarea asp-for="Address" rows="4" placeholder="Jalan, nomor rumah, kota"></textarea></div><div class="field"><label asp-for="Payment">Metode pembayaran</label><select asp-for="Payment"><option>Transfer bank</option><option>COD</option><option>E-wallet</option></select></div><button class="button button-primary button-full" type="submit">Buat pesanan <span>&rarr;</span></button></form><aside class="summary-card checkout-summary"><p class="eyebrow">Pesananmu</p>@foreach (var item in Model.Items) { <div class="summary-product"><span>@item.Name <small>x @item.Quantity</small></span><strong>@item.Total.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</strong></div> }<div class="summary-total"><span>Total</span><strong>@Model.Total.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</strong></div></aside></div>
