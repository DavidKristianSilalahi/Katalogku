@page
@model RegisterModel
@{ ViewData["Title"] = "Daftar"; }
<div class="auth-shell auth-shell-reverse"><div class="auth-art"><p class="eyebrow">KatalogKu / akun baru</p><h1>Mulai ruang<br /><em>belanjamu.</em></h1><p>Buat akun pelanggan dan nikmati pengalaman checkout yang lebih rapi.</p></div><div class="auth-card"><div class="eyebrow">Gabung sekarang</div><h2>Buat akun</h2>@if (Model.ErrorMessage is not null) { <div class="validation">@Model.ErrorMessage</div> }<form method="post" class="auth-form"><div class="field"><label asp-for="Username">Username</label><input asp-for="Username" placeholder="Minimal 3 karakter" /></div><div class="field"><label asp-for="Password">Password</label><input asp-for="Password" type="password" placeholder="Minimal 6 karakter" /></div><div class="field"><label asp-for="ConfirmPassword">Konfirmasi password</label><input asp-for="ConfirmPassword" type="password" placeholder="Ulangi password" /></div><button class="button button-primary button-full" type="submit">Buat akun <span>&rarr;</span></button></form><p class="auth-note">Sudah punya akun? <a asp-page="/Login">Masuk di sini</a></p></div></div>
