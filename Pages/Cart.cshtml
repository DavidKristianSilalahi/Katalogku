@page
@model CartModel
@{ ViewData["Title"] = "Keranjang"; }
<section class="page-heading"><a class="back-link" asp-page="/Shop">&larr; Lanjut belanja</a><p class="eyebrow">Ruang pesanan</p><h1>Keranjang<br /><em>belanjamu.</em></h1></section>
@if (Model.Items.Count == 0) { <div class="empty-cart"><div class="empty-icon">+</div><h2>Keranjang masih kosong</h2><p>Pilih produk yang kamu suka dari katalog.</p><a class="button button-primary" asp-page="/Shop">Lihat katalog <span>&rarr;</span></a></div> }
else { <div class="cart-layout"><section class="cart-list"><div class="cart-list-heading"><span>@Model.Items.Count item</span><span>Detail pilihan</span></div>@foreach (var item in Model.Items) { <article class="cart-item"><div class="cart-item-image">@if (!string.IsNullOrWhiteSpace(item.ImagePath)) { <img src="@item.ImagePath" alt="@item.Name" /> } else { <span>IMG</span> }</div><div class="cart-item-info"><h3>@item.Name</h3><p>Produk pilihan KatalogKu</p><strong>@item.Price.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</strong></div><form method="post" asp-page-handler="Update" asp-route-id="@item.ProductId" class="quantity-form"><input type="number" name="quantity" value="@item.Quantity" min="1" /><button type="submit">Update</button></form><div class="cart-item-total">@item.Total.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</div><form method="post" asp-page-handler="Remove" asp-route-id="@item.ProductId"><button class="remove-link" type="submit">Hapus</button></form></article> }</section><aside class="summary-card"><p class="eyebrow">Ringkasan</p><h2>Pesananmu</h2><div class="summary-row"><span>Subtotal</span><strong>@Model.Subtotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</strong></div><div class="summary-row"><span>Pengiriman</span><strong>Gratis</strong></div><div class="summary-total"><span>Total</span><strong>@Model.Subtotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</strong></div><a class="button button-primary button-full" asp-page="/Checkout">Lanjut checkout <span>&rarr;</span></a></aside></div> }
